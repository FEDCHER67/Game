{
 "asset": "PLAYER_SAUSAGE_W86",
 "revision": "v01",
 "note": "The player as a customisable Sausage Buddy (Fedya 2026-10-29). Same Buddy_Rig_Mixamo65 (65 Mixamo bones, BASE rest pose) as every Sausage Buddy NPC: every shared NPC clip plays on it. One option per aspect is worn at a time. The game shows the base meshes, the chosen option mesh of each aspect, and hides every Body_* region listed in hides_body_regions of the chosen top and bottom. While a headwear option with hair_under_hat = true is worn, the hair option shows mesh_under_hat instead of mesh.",
 "files": {
  "blend": "PLAYER_SAUSAGE_W86_v01.blend",
  "fbx_base": "PLAYER_SAUSAGE_W86_v01_base.fbx",
  "fbx_parts": "PLAYER_SAUSAGE_W86_v01_parts.fbx",
