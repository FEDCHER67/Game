Label { color: rgb(231, 224, 208); font-size: 14px; margin-bottom: 5px; white-space: normal; }
#hud { position: absolute; left: 20px; top: 20px; width: 430px; padding: 20px; background-color: rgba(25, 35, 32, .95); border-radius: 12px; }
.eyebrow { color: rgb(219, 174, 89); font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; }
.title { font-size: 27px; -unity-font-style: bold; }
.subtitle { margin-bottom: 12px; color: rgb(173, 190, 173); }
.row { flex-direction: row; align-items: center; margin-top: 6px; margin-bottom: 8px; }
#swatch { width: 20px; height: 20px; border-radius: 10px; margin-right: 10px; }
#tools { -unity-font-style: bold; }
#size { color: rgb(179, 194, 180); font-size: 12px; margin-bottom: 12px; }
#status { color: rgb(239, 197, 111); margin-top: 12px; }
#text-panel { position: absolute; left: 29%; top: 42%; width: 570px; padding: 24px; background-color: rgb(25, 35, 32); border-radius: 12px; display: none; }
#lettering { margin-top: 12px; margin-bottom: 12px; font-size: 30px; height: 50px; }
Button { height: 36px; padding-left: 16px; padding-right: 16px; margin-right: 10px; background-color: rgb(211, 169, 87); color: rgb(25, 35, 32); border-width: 0; border-radius: 5px; }
